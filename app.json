{
  "expo": {
    "name": "ЧтоДальше",
    "slug": "whatnext",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "scheme": "whatnext",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.whatnext.mobile"
    },
    "android": {
      "package": "app.whatnext.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#45673B"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png",
      "name": "ЧтоДальше",
      "description": "Твои планы на свободное время"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 96,
          "resizeMode": "contain",
          "backgroundColor": "#F8F8F5"
        }
      ]
    ]
  }
}
